# StudioFlow - Supabase Environment Variables Template
# Copy this file to .env or set these environment variables in your deployment platform

# Supabase PostgreSQL Connection
# In Supabase: Project Settings -> Database -> Connection string -> JDBC / URI
# Note: Use port 6543 (transaction pooler) or 5432 (session pooler/direct) with sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=[YOUR-SUPABASE-DB-PASSWORD]

# JWT Secret Key (HMAC-SHA256, at least 256 bits / 32 bytes)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Conflict Detection Settings
MINIMUM_TRAVEL_MINUTES=45
PORT=8080
